# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Agent Identity Auth Provider Resource Name or ID
# Full format: projects/{project}/locations/{location}/authProviders/{auth_provider_id}
AGENT_AUTH_PROVIDER_NAME=gmail-agent-auth-provider

# Optional: Target User Email (if needed by your agent tools)
TARGET_USER_EMAIL=user@yourdomain.com
